<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:fitsSystemWindows="false">

    <!-- 1. TOP TRICOLOR EDGE-TO-EDGE IDENTITY STRIP -->
    <LinearLayout
        android:id="@+id/splash_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- Top Edge-to-Edge Tricolor Bar (Navy, Saffron, White, India Green) -->
        <View
            android:id="@+id/splash_top_bar"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:background="@drawable/splash_top_tricolor" />

        <!-- Soft Atmospheric Top Wash (Pure XML Gradient) -->
        <View
            android:id="@+id/splash_top_wash"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/splash_top_gradient" />
    </LinearLayout>

    <!-- 2. CENTER BRANDING CONTAINER (True VectorDrawable + Native Android Typography) -->
    <LinearLayout
        android:id="@+id/splash_center_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Vector Metrology Icon (Pure VectorDrawable XML - NO RASTER BITMAP) -->
        <ImageView
            android:id="@+id/splash_metrology_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_metrology_scale"
            android:contentDescription="@string/app_name" />

        <!-- Primary Product Name -->
        <TextView
            android:id="@+id/splash_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/splash_app_title"
            android:textColor="@color/colorNavy"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01" />

        <!-- Official Hindi Portal Title -->
        <TextView
            android:id="@+id/splash_hindi_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/splash_hindi_title"
            android:textColor="@color/colorDarkNavy"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <!-- Tricolor Accent Divider (Pure XML Layer-list) -->
        <View
            android:id="@+id/splash_divider"
            android:layout_width="120dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/splash_tricolor_divider" />

        <!-- Statutory Division Hierarchy -->
        <TextView
            android:id="@+id/splash_division"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_division"
            android:textColor="@color/colorNavy"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/splash_department"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/splash_dept"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/splash_government"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/splash_gov"
            android:textColor="@color/colorTextMuted"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- SIH Problem Statement Badge (Pure XML ShapeDrawable) -->
        <TextView
            android:id="@+id/splash_sih_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/splash_badge_bg"
            android:text="@string/splash_sih_problem"
            android:textColor="@color/colorNavy"
            android:textSize="10.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 3. BOTTOM TRICOLOR EDGE-TO-EDGE GROUNDING STRIP -->
    <LinearLayout
        android:id="@+id/splash_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Authority Attribution (Sits safely above navigation / gesture bar) -->
        <TextView
            android:id="@+id/splash_authority_hindi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="@string/splash_dept_hindi"
            android:textColor="@color/colorNavy"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splash_authority_gov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/splash_gov"
            android:textColor="@color/colorTextMuted"
            android:textSize="10sp" />

        <!-- Bottom Edge-to-Edge Tricolor & Navy Anchor Bar -->
        <View
            android:id="@+id/splash_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:background="@drawable/splash_bottom_tricolor" />
    </LinearLayout>

</FrameLayout>
