<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Saffron Stripe -->
    <item
        android:top="0dp"
        android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF9933" />
        </shape>
    </item>
    <!-- White Stripe -->
    <item
        android:top="3dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- India Green Stripe -->
    <item
        android:top="4dp"
        android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#138808" />
        </shape>
    </item>
    <!-- Bottom Deep Navy Anchor Band -->
    <item
        android:top="7dp"
        android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#07366B" />
        </shape>
    </item>
</layer-list>
