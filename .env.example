# PORT: Port for the backend API and web interface
PORT=3000

# MONGO_URI: MongoDB connection string (e.g. mongodb://localhost:27017/legal_metrology or Atlas mongodb+srv://...)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Legal-Metrology

# JWT configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=8h

# URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# Mobile / Frontend API URL (leave empty for web relative '/api' proxy, or set to your backend HTTPS URL for Android/iOS builds)
VITE_API_URL=

# Application URL (injected by AI Studio / Cloud Run in cloud environments)
APP_URL=http://localhost:3000

# Email / SMTP configuration for notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply-legalmetrology@doca.gov.in

# File upload directory path
UPLOAD_DIR=./uploads

# Admin setup credentials for seed script (npm run create-admin or automated server bootstrap)
ADMIN_INITIAL_NAME=Super Administrator
ADMIN_INITIAL_EMAIL=admin@doca.gov.in
ADMIN_INITIAL_PASSWORD=your_secure_admin_password
ADMIN_INITIAL_PHONE=
